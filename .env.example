# Session-bound headers (copy từ Chrome DevTools → Network → GraphQL request).
# Cookie `bm_s` hết hạn sau ~30 ngày — phải refresh bằng cách mở Chrome,
# vào 1 URL từ link generator, copy lại.

TRV_COOKIE=
TRV_TID=
TRV_CONNECTION_ID=
TRV_CST=
TRV_SEQUENCE_ID=

TRV_POLL_ID=
TRV_POLL_NUMBER=0
TRV_POLL_RETRY=0
TRV_SEES_RESULTS=false

TRV_LANGUAGE=
TRV_PLATFORM=
TRV_CURRENCY=

TRV_DRS_PARAM=drs-48
TRV_LOCALE=vi

# PostgreSQL (used by linkgenerator/config.py)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trivago
DB_USER=postgres
DB_PASSWORD=
